# Base URL for the application
# Used for canonical URLs, Open Graph tags, and structured data
# Default: window.location.origin (in browser) or https://sessionplan.de (build)
VITE_BASE_URL=http://localhost:5173

# Optional: Backend endpoint for Dynamic Link / server sync
# If not set, the Dynamic Link feature is disabled and all data stays local
# VITE_SESSIONS_API=/data/sessions.php
