# Optional Dynamic Link API; defaults to a same-origin /data/sessions.php endpoint.
# Without a backend the planner continues to work locally.
# VITE_SESSIONS_API=https://your-server.example.com/data/sessions.php
# Local development (npm run dev:full serves the API on port 8081):
# VITE_SESSIONS_API=http://localhost:8081/data/sessions.php

# Server-side configuration for the sessions API (PHP). Set on the PHP
# runtime, not in the Vite dev server. `npm run dev:api` presets
# SP_ENV=development (localhost origins allowed); production deployments set
# the storage root outside the webroot instead.
#  SP_SESSIONS_DIR=/var/lib/sessionplan/sessions   # Outside the webroot.
#  SP_ALLOWED_ORIGIN=https://staging.example.com  # Optional extra CORS origin (single exact match).